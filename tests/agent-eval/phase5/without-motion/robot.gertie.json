          "pivot": [0, 50],
          "children": [
            { "id": "antenna-stem", "type": "rect", "w": 8, "h": 40, "x": 0, "y": -90, "fill": "$dark" },
            { "id": "antenna-ball", "type": "ellipse", "r": 13, "y": -118, "fill": "$accent",
              "animate": { "scale": [[0, 1], [0.5, 1.25, "easeInOutSine"], [1, 1, "easeInOutSine"], [1.5, 1.25, "easeInOutSine"], [2, 1, "easeInOutSine"]] } },
            { "id": "head-shape", "type": "rect", "w": 150, "h": 120, "radius": 34, "fill": "$body" },
            { "id": "face", "type": "rect", "w": 120, "h": 70, "radius": 24, "y": 0, "fill": "$dark" },
            { "id": "eye-l", "type": "ellipse", "rx": 12, "ry": 14, "x": -28, "y": -4, "fill": "$accent",
              "animate": { "scale": [[0, [1, 1]], [0.9, [1, 1]], [1.0, [1, 0.1], "easeInOutQuad"], [1.1, [1, 1], "easeInOutQuad"], [2, [1, 1]]] } },
            { "id": "eye-r", "type": "ellipse", "rx": 12, "ry": 14, "x": 28, "y": -4, "fill": "$accent",
              "animate": { "scale": [[0, [1, 1]], [0.9, [1, 1]], [1.0, [1, 0.1], "easeInOutQuad"], [1.1, [1, 1], "easeInOutQuad"], [2, [1, 1]]] } },
            { "id": "mouth", "type": "path", "d": "M -22 18 Q 0 34 22 18", "fill": null,
              "stroke": { "color": "#38bdf8", "width": 5 } },
            { "id": "cheek-l", "type": "ellipse", "rx": 9, "ry": 6, "x": -48, "y": 22, "fill": "#fb7185aa" },
            { "id": "cheek-r", "type": "ellipse", "rx": 9, "ry": 6, "x": 48, "y": 22, "fill": "#fb7185aa" }
          ] }
      ] }
