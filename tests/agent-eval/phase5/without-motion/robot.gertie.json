{
  "gertie": 1, "name": "friendly-robot",
  "canvas": { "w": 512, "h": 512 }, "duration": 2, "fps": 30,
  "poster": 1,
  "palette": { "body": "#94a3b8", "dark": "#334155", "accent": "#38bdf8", "light": "#e2e8f0" },
  "nodes": [
    { "id": "shadow", "type": "ellipse", "rx": 90, "ry": 12, "x": 256, "y": 462, "fill": "#00000040" },
    { "id": "robot", "type": "group", "x": 256, "y": 0,
      "animate": { "y": [[0, 0], [0.5, -6, "easeOutSine"], [1, 0, "easeInSine"], [1.5, -6, "easeOutSine"], [2, 0, "easeInSine"]] },
      "children": [
        { "id": "leg-l", "type": "rect", "w": 30, "h": 50, "radius": 8, "x": -35, "y": 435, "fill": "$dark" },
        { "id": "leg-r", "type": "rect", "w": 30, "h": 50, "radius": 8, "x": 35, "y": 435, "fill": "$dark" },
        { "id": "arm-l", "type": "group", "x": -88, "y": 255,
          "children": [
            { "id": "arm-l-shape", "type": "rect", "w": 26, "h": 90, "radius": 13, "y": 40, "fill": "$body" },
            { "id": "hand-l", "type": "ellipse", "r": 18, "y": 92, "fill": "$light" }
          ] },
        { "id": "arm-r", "type": "group", "x": 88, "y": 255,
          "animate": { "rotation": [
            [0, 0], [0.35, -150, "easeOutBack"], [0.55, -178, "easeInOutSine"], [0.75, -135, "easeInOutSine"],
            [0.95, -178, "easeInOutSine"], [1.15, -135, "easeInOutSine"], [1.35, -178, "easeInOutSine"],
            [1.55, -140, "easeInOutSine"], [2, 0, "easeInOutCubic"]
          ] },
          "children": [
            { "id": "arm-r-shape", "type": "rect", "w": 26, "h": 90, "radius": 13, "y": 40, "fill": "$body" },
            { "id": "hand-r", "type": "ellipse", "r": 18, "y": 92, "fill": "$light" }
          ] },
        { "id": "torso", "type": "rect", "w": 150, "h": 150, "radius": 28, "y": 290, "fill": "$body" },
        { "id": "chest-light", "type": "ellipse", "r": 14, "y": 330, "fill": "$accent",
          "animate": { "opacity": [[0, 1], [1, 0.4, "easeInOutSine"], [2, 1, "easeInOutSine"]] } },
        { "id": "neck", "type": "rect", "w": 30, "h": 24, "x": -15, "y": 212, "fill": "$dark" },
        { "id": "head", "type": "group", "y": 180,
