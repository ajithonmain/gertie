          "children": [
            { "id": "arm-r-bar", "type": "rect", "w": 28, "h": 110, "radius": 14, "x": 0, "y": 55, "fill": "$body" },
            { "id": "hand-r", "type": "ellipse", "r": 24, "x": 0, "y": 122, "fill": "$warm" }
          ] }
      ] }
