        { "id": "leg-l", "type": "rect", "w": 36, "h": 50, "radius": 10, "x": 222, "y": 440, "fill": "$dark" },
        { "id": "leg-r", "type": "rect", "w": 36, "h": 50, "radius": 10, "x": 290, "y": 440, "fill": "$dark" },
        { "id": "arm-l", "type": "group", "x": 168, "y": 330,
