{
  "gertie": 1,
  "name": "success-check",
  "tier": "icon",
  "canvas": { "w": 512, "h": 512 },
  "fps": 30,
  "duration": 2.5,
  "loop": false,
  "poster": 2.5,
  "palette": {
    "green": "#22c55e",
    "deep": "#16a34a",
    "light": "#dcfce7",
    "white": "#ffffff"
  },
  "nodes": [
    {
      "id": "badge", "type": "group", "x": 256, "y": 256,
      "animate": {
        "scale": [[0, 1], [1.05, 1], [1.2, 0.94, "easeOutQuad"], [1.55, 1, "easeOutBack"]]
      },
      "children": [
        {
          "id": "halo", "type": "ellipse", "r": 150, "fill": "$light", "opacity": 0,
          "animate": {
            "scale": [[0.55, 0.85], [1.3, 1.12, "easeOutCubic"]],
            "opacity": [[0.55, 0], [0.75, 0.9, "easeOut"], [1.3, 0, "easeInQuad"]]
          }
        },
        {
          "id": "ring", "type": "ellipse", "r": 150, "rotation": -90,
          "stroke": { "color": "$green", "width": 14, "cap": "round" },
          "trim": { "start": 0, "end": 0 },
          "animate": {
            "trim.end": [[0, 0], [0.6, 1, "easeInOutCubic"]]
          }
        },
        {
          "id": "disc", "type": "ellipse", "r": 150,
          "fill": { "type": "linear", "from": [0, -150], "to": [0, 150], "stops": [[0, "$green"], [1, "$deep"]] },
          "animate": {
            "scale": [[0.5, 0], [0.9, 1, "easeOutBack"]]
          }
        },
        {
          "id": "check", "type": "path",
          "d": "M -68 4 L -22 50 L 72 -50",
          "stroke": { "color": "$white", "width": 22, "cap": "round", "join": "round" },
          "trim": { "start": 0, "end": 0 },
          "animate": {
            "trim.end": [[0.8, 0], [1.25, 1, "easeOutCubic"]]
          }
        }
      ]
    }
  ]
}
