{
  "gertie": 1,
  "name": "toast",
  "tier": "icon",
  "canvas": { "w": 512, "h": 200 },
  "fps": 60,
  "duration": 3,
  "loop": true,
  "poster": 1.5,
  "palette": {
    "card": "#ffffff",
    "edge": "#e2e8f0",
    "shadow": "#0f172a22",
    "green": "#22c55e",
    "greenSoft": "#dcfce7",
    "title": "#0f172a",
    "body": "#94a3b8",
    "close": "#cbd5e1"
  },
  "nodes": [
    {
      "id": "toast",
      "type": "group",
      "x": 256,
      "animate": {
        "y": [
          [0, -70],
          [0.55, 76, "easeOutBack"],
          [2.35, 76, "hold"],
          [2.8, -70, "easeInBack"],
          [3, -70]
        ],
        "opacity": [
          [0, 0],
          [0.3, 1, "easeOut"],
          [2.55, 1],
          [2.8, 0, "easeIn"],
          [3, 0]
        ]
      },
      "children": [
        { "id": "shadow", "type": "rect", "w": 356, "h": 72, "radius": 16, "y": 8, "fill": "$shadow" },
        {
          "id": "card", "type": "rect", "w": 360, "h": 72, "radius": 14,
          "fill": { "type": "linear", "from": [0, -36], "to": [0, 36], "stops": [[0, "#ffffff"], [1, "#f8fafc"]] },
          "stroke": { "color": "$edge", "width": 1.5 }
        },
        {
          "id": "badge", "type": "ellipse", "r": 18, "x": -142, "fill": "$greenSoft", "pivot": [0, 0],
          "animate": { "scale": [[0, 0.4], [0.45, 0.4], [0.8, 1, "easeOutBack"], [2.9, 1], [3, 0.4, "hold"]] }
        },
        {
          "id": "check", "type": "path", "x": -142,
          "d": "M -8 0 L -2 6 L 9 -6",
          "stroke": { "color": "$green", "width": 4, "cap": "round", "join": "round" },
          "trim": { "start": 0, "end": 0 },
          "animate": { "trim.end": [[0, 0], [0.6, 0], [0.95, 1, "easeOutCubic"], [2.8, 1], [3, 0, "hold"]] }
        },
        { "id": "title-line", "type": "rect", "w": 150, "h": 10, "radius": 5, "x": -33, "y": -10, "fill": "$title" },
        { "id": "body-line", "type": "rect", "w": 200, "h": 8, "radius": 4, "x": -8, "y": 11, "fill": "$body" },
        { "id": "close-a", "type": "line", "x1": 136, "y1": -6, "x2": 148, "y2": 6, "stroke": { "color": "$close", "width": 2.5 } },
        { "id": "close-b", "type": "line", "x1": 148, "y1": -6, "x2": 136, "y2": 6, "stroke": { "color": "$close", "width": 2.5 } },
        {
          "id": "progress", "type": "rect", "w": 332, "h": 3, "radius": 1.5, "y": 33, "x": 0, "pivot": [-166, 0],
          "fill": "$green",
          "animate": { "scale": [[0, [1, 1]], [0.55, [1, 1]], [2.35, [0, 1], "linear"], [2.9, [0, 1]], [3, [1, 1], "hold"]] }
        }
      ]
    }
  ]
}
