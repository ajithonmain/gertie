{
  "gertie": 1,
  "name": "iris-transition",
  "canvas": { "w": 512, "h": 512, "background": "#0b0f1a" },
  "fps": 30,
  "duration": 3,
  "loop": false,
  "poster": 3,
  "palette": {
    "iris": "#0b0f1a",
    "rim": "#f5c542",
    "sun": "#ffd166",
    "hill-1": "#5cb85c",
    "hill-2": "#3e8e41",
    "moon": "#f1f5f9",
    "night-hill-1": "#1e3a5f",
    "night-hill-2": "#142640",
    "star": "#fde68a"
  },
  "nodes": [
    {
      "id": "scene-day", "type": "group", "from": 0, "to": 1.5,
      "children": [
        { "id": "day-sky", "type": "rect", "x": 256, "y": 256, "w": 512, "h": 512,
          "fill": { "type": "linear", "from": [0, -256], "to": [0, 256], "stops": [[0, "#4fa3e0"], [1, "#bfe6ff"]] } },
        { "id": "day-sun", "type": "ellipse", "x": 370, "y": 150, "r": 56,
          "fill": { "type": "radial", "center": [-14, -14], "radius": 70, "stops": [[0, "#fff3c4"], [1, "$sun"]] } },
        { "id": "day-hill-back", "type": "path", "fill": "$hill-2",
          "d": "M0 360 C 90 300 180 300 270 345 C 360 390 440 320 512 330 L 512 512 L 0 512 Z" },
        { "id": "day-hill-front", "type": "path", "fill": "$hill-1",
          "d": "M0 420 C 110 370 220 380 300 410 C 380 440 450 400 512 395 L 512 512 L 0 512 Z" }
      ]
    },
    {
      "id": "scene-night", "type": "group", "from": 1.5, "to": 3,
      "children": [
        { "id": "night-sky", "type": "rect", "x": 256, "y": 256, "w": 512, "h": 512,
          "fill": { "type": "linear", "from": [0, -256], "to": [0, 256], "stops": [[0, "#0f1b3d"], [1, "#3b4a7a"]] } },
        { "id": "night-moon", "type": "path", "fill": "$moon",
          "d": "M150 90 C 105 100 80 140 85 180 C 92 228 140 256 188 244 C 150 232 125 198 128 160 C 131 126 150 100 150 90 Z" },
        { "id": "star-1", "type": "star", "points": 4, "r": 8, "innerR": 3, "x": 300, "y": 90, "fill": "$star" },
        { "id": "star-2", "type": "star", "points": 4, "r": 6, "innerR": 2, "x": 410, "y": 150, "fill": "$star" },
        { "id": "star-3", "type": "star", "points": 4, "r": 7, "innerR": 2.5, "x": 250, "y": 200, "fill": "$star" },
        { "id": "star-4", "type": "star", "points": 4, "r": 5, "innerR": 2, "x": 460, "y": 70, "fill": "$star" },
        { "id": "night-hill-back", "type": "path", "fill": "$night-hill-1",
          "d": "M0 350 C 100 310 200 320 280 350 C 360 380 440 330 512 340 L 512 512 L 0 512 Z" },
        { "id": "night-hill-front", "type": "path", "fill": "$night-hill-2",
          "d": "M0 415 C 120 380 210 385 300 405 C 390 425 450 410 512 400 L 512 512 L 0 512 Z" }
      ]
    },
    {
      "id": "iris-rim", "type": "ellipse", "x": 256, "y": 256, "r": 0.5,
      "stroke": { "color": "$rim", "width": 6 },
      "animate": {
        "r": [[0.2, 0.5], [1.3, 372, "easeInCubic"], [1.7, 372], [2.8, 0.5, "easeOutCubic"]],
        "opacity": [[0.2, 0], [0.35, 1, "easeOut"], [1.2, 1], [1.3, 0, "easeIn"], [1.7, 0], [1.8, 1, "easeOut"], [2.65, 1], [2.8, 0, "easeIn"]]
      }
    },
    {
      "id": "iris", "type": "ellipse", "x": 256, "y": 256, "r": 0.5, "fill": "$iris",
      "animate": {
        "r": [[0.2, 0.5], [1.3, 372, "easeInCubic"], [1.7, 372], [2.8, 0.5, "easeOutCubic"]]
      }
    }
