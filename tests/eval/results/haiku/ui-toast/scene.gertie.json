{
  "gertie": 1,
  "name": "toast",
  "canvas": { "w": 480, "h": 160 },
  "fps": 30,
  "duration": 3,
  "loop": false,
  "poster": 1.5,
  "palette": {
    "card": "#1e293b",
    "shadow": "#020617",
    "ok": "#22c55e",
    "text": "#e2e8f0",
    "muted": "#64748b",
    "track": "#334155",
    "bar": "#38bdf8"
  },
  "nodes": [
    {
      "id": "toast",
      "type": "group",
      "x": 240,
      "y": 80,
      "motion": [
        { "preset": "slide-in", "from": "top", "distance": 140, "at": 0, "duration": 0.55 },
        { "preset": "slide-out", "to": "top", "distance": 140, "at": 2.4, "duration": 0.5 }
      ],
      "children": [
        { "id": "toast-shadow", "type": "rect", "w": 380, "h": 76, "radius": 14, "y": 6,
          "fill": "$shadow", "opacity": 0.35 },
        { "id": "toast-card", "type": "rect", "w": 380, "h": 76, "radius": 14,
          "fill": "$card" },
        { "id": "toast-icon", "type": "ellipse", "r": 16, "x": -140, "y": 0,
          "fill": "$ok" },
        { "id": "toast-check", "type": "path", "d": "M -148 0 L -141 7 L -131 -6",
          "fill": null, "stroke": { "color": "#ffffff", "width": 4, "cap": "round", "join": "round" } },
        { "id": "toast-title", "type": "rect", "w": 180, "h": 12, "radius": 6, "x": -10, "y": -8,
          "fill": "$text" },
        { "id": "toast-body", "type": "rect", "w": 120, "h": 10, "radius": 5, "x": -40, "y": 12,
          "fill": "$muted" },
        { "id": "toast-track", "type": "line", "x1": -160, "y1": 28, "x2": 160, "y2": 28,
          "stroke": { "color": "$track", "width": 4, "cap": "round" } },
        { "id": "toast-progress", "type": "line", "x1": -160, "y1": 28, "x2": 160, "y2": 28,
          "stroke": { "color": "$bar", "width": 4, "cap": "round" },
          "trim": { "start": 0, "end": 1 },
          "animate": { "trim.start": [[0.55, 0], [2.4, 1, "linear"]] } }
      ]
    }
  ]
}
