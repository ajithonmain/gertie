    { "id": "dot-2", "type": "ellipse", "r": 11, "x": 120, "y": 60, "fill": "$dot",
      "motion": [ { "preset": "bounce", "height": 18, "duration": 1.2, "repeat": "loop", "phase": 0.125 } ] },
    { "id": "dot-3", "type": "ellipse", "r": 11, "x": 150, "y": 60, "fill": "$dot",
      "motion": [ { "preset": "bounce", "height": 18, "duration": 1.2, "repeat": "loop", "phase": 0.25 } ] }
  ]
}
