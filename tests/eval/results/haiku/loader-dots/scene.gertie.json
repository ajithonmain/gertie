{
  "gertie": 1,
  "name": "typing-indicator",
  "tier": "icon",
  "canvas": { "w": 240, "h": 120 },
  "fps": 30,
  "duration": 1.2,
  "loop": true,
  "poster": 0.3,
  "palette": { "dot": "#64748b" },
