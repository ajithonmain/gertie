        "star-b": { "pivot": [252, 226.2], "motion": [{ "preset": "spin", "duration": 1.2, "direction": "ccw", "repeat": "loop" }] },
        "dots": { "motion": [{ "preset": "float", "distance": 6, "at": 0.3, "duration": 2.1 }] }
      }
    }
  ]
