{
  "gertie": 1,
  "name": "follow-chain",
  "canvas": { "w": 512, "h": 512 },
  "fps": 30,
  "duration": 4,
  "loop": true,
  "palette": { "bar": "#94a3b8", "link-a": "#38bdf8", "link-b": "#22d3ee", "link-c": "#2dd4bf", "link-d": "#34d399" },
  "nodes": [
    { "id": "beam", "type": "rect", "w": 240, "h": 20, "radius": 8, "x": 256, "y": 70, "fill": "$bar" },
    {
      "id": "link-1", "type": "group", "pivot": [256, 80],
      "animate": { "rotation": [[0, 0], [1, 9, "smooth"], [2, 0, "smooth"], [3, -9, "smooth"], [4, 0, "smooth"]] },
      "children": [
        { "id": "link-1-body", "type": "rect", "w": 34, "h": 110, "radius": 17, "x": 256, "y": 135, "fill": "$link-a" },
        {
          "id": "link-2", "type": "group", "pivot": [256, 190], "follow": { "delay": 0.15, "scale": 1.3 },
          "children": [
            { "id": "link-2-body", "type": "rect", "w": 30, "h": 100, "radius": 15, "x": 256, "y": 240, "fill": "$link-b" },
            {
              "id": "link-3", "type": "group", "pivot": [256, 290], "follow": { "delay": 0.15, "scale": 1.3 },
              "children": [
                { "id": "link-3-body", "type": "rect", "w": 26, "h": 90, "radius": 13, "x": 256, "y": 335, "fill": "$link-c" },
                {
                  "id": "link-4", "type": "group", "pivot": [256, 380], "follow": { "delay": 0.15, "scale": 1.3 },
                  "children": [
                    { "id": "link-4-body", "type": "ellipse", "r": 34, "x": 256, "y": 415, "fill": "$link-d" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
