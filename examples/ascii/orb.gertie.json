      "children": [
        { "id": "moon", "type": "ellipse", "r": 34, "x": 205, "y": 0,
          "fill": { "type": "radial", "center": [-10, -10], "radius": 50, "stops": [[0, "#ffffff"], [1, "#4a4a4a"]] } }
      ] }
